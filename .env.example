# Optional. Copy to .env if you need them (server runs without any of these).

# Advertise this IPv4 as the only WebRTC host candidate / multicast NIC.
# Useful behind Docker host networking or multi-homed machines.
# HOST_IP=192.168.1.10

# LL-HLS segment target duration in seconds (0.25–6). Default is built-in.
# HLS_TIME=1

# LL-HLS playlist sliding window size (7–15).
# HLS_LIST_SIZE=10

# Overlay timestamp offset in milliseconds (can be negative).
# AI_OFFSET_MS=0
