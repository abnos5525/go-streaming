# Optional. Copy to .env if you need them (server runs without any of these).

# go-streaming docs / scenario (Vite). Base URL for stream + PTZ API.
# VITE_API_BASE_URL=http://127.0.0.1:8085

# Advertise this IPv4 as the only WebRTC host candidate / multicast NIC.
# Useful behind Docker host networking or multi-homed machines.
# HOST_IP=192.168.1.10

# LL-HLS segment target duration in seconds (0.25–6). Default is built-in.
# HLS_TIME=1

# LL-HLS playlist sliding window size (7–15).
# HLS_LIST_SIZE=10

# Overlay timestamp offset in milliseconds (can be negative).
# AI_OFFSET_MS=0

# When set, GET / requires Authorization: Bearer <HS256 JWT>.
# Stream routes stay public. Mint a token with: go run ./cmd/token
# AUTH_SECRET=dev-secret

# gRPC control API. Start, Stop, and Status. Default 127.0.0.1:9095.
# GRPC_ADDR=127.0.0.1:9095

# GStreamer runtime for RTSP remux. Set GST_ROOT to the MSVC install root (contains bin/gst-launch-1.0.exe).
# GST_ROOT=D:\gstreamer\PFiles64\gstreamer\1.0\msvc_x86_64

# Public lake webcam at Štrbské Pleso. Start plays this.
# The scenario can switch to the local picture on udp://127.0.0.1:5600.
# DEMO_CAMERA_URL=rtsp://stream.strba.sk:1935/strba/VYHLAD_JAZERO.stream
